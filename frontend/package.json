{
  "name": "day-sheet-maker",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.js",
  "description": "An app for generating and managing day sheets.",
  "author": {
    "name": "Emma Talley",
    "email": "mcrib40@gmail.com"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron ./electron/main.js\"",
    "build": "vite build && electron-builder --win nsis",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^24.13.3",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.0.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.emma.daysheetmaker",
    "productName": "DaySheet Maker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../backend/src/dist/daysheet-backend",
        "to": "backend/daysheet-backend"
      },
      {
        "from": "../defaults/settings.json",
        "to": "defaults/settings.json"
      },
      {
        "from": "../assets",
        "to": "assets"
      }
    ],
    "win": {
      "icon": "../assets/lilWorkerBuddy.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false,
      "artifactName": "DaySheetMaker-Setup-${version}.exe"
    }
  }
}
